# Copy this file to `.env` in the same folder (`backend/.env`) and fill in values.
# `.env` is gitignored — never commit secrets.

# --- Database (optional locally; use Neon URL on Render) ---
# Omit or comment out to use SQLite at ./assessment_submissions.db
# Neon: paste the connection string from the Neon dashboard (includes sslmode=require).
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# --- Email: SMTP (works on your machine; Render free tier blocks SMTP — use Brevo API there) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com

# --- Email: Brevo HTTPS API (recommended on Render free tier) ---
# BREVO_API_KEY=
# BREVO_SENDER=Your Name <verified@yourdomain.com>

# --- Email: Resend ---
# RESEND_API_KEY=
# EMAIL_FROM=EU AI Act Readiness <onboarding@resend.dev>

# --- Admin export routes ---
# ADMIN_API_KEY=generate-a-long-random-string

# --- CORS: frontend origins (comma-separated), e.g. Vercel preview + prod ---
# CORS_ALLOW_ORIGINS=https://your-app.vercel.app
