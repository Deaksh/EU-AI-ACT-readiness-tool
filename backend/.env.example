# Copy to `backend/.env` and fill in. `backend/.env` is gitignored.
# If you ever committed real secrets, rotate them in Gmail/Brevo/Render/Neon.

# --- Database: omit locally for SQLite. On Render, set Neon connection string. ---
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# --- Admin: API key (curl) + JWT signing; also used to sign web session tokens if ADMIN_JWT_SECRET unset ---
ADMIN_API_KEY=generate-a-long-random-string

# --- Admin web UI (login on frontend): password required; email defaults to beaconone.org@gmail.com ---
# ADMIN_EMAIL=beaconone.org@gmail.com
ADMIN_PASSWORD=choose-a-strong-password

# Optional separate JWT signing secret (defaults to ADMIN_API_KEY):
# ADMIN_JWT_SECRET=

# --- Email: SMTP (fine on localhost; Render free tier blocks SMTP — use Brevo API there) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com

# --- Email: Brevo HTTPS API (recommended on Render free tier) ---
# BREVO_API_KEY=
# BREVO_SENDER=Your Name <verified@yourdomain.com>

# --- Email: Resend ---
# RESEND_API_KEY=
# EMAIL_FROM=EU AI Act Readiness <onboarding@resend.dev>

# --- CORS: frontend origins (comma-separated) ---
# CORS_ALLOW_ORIGINS=https://your-app.vercel.app
